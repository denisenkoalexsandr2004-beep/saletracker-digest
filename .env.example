# Public URL used to build personal preview and settings links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Public username without @. Without it the app safely works in demo mode.
TELEGRAM_BOT_USERNAME=

# Server-only Telegram secrets. Never prefix them with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_SECRET=

# Persistent PostgreSQL storage. Without it the app uses the explicit local demo adapter.
DATABASE_URL=
DB_POOL_SIZE=5

# Same-domain admin session. ADMIN_PASSWORD may differ from TELEGRAM_ADMIN_SECRET.
ADMIN_PASSWORD=
SESSION_SECRET=

# Protects scheduled job endpoints called by the production scheduler.
CRON_SECRET=

# AI news research.
OPENAI_API_KEY=
OPENAI_NEWS_MODEL=gpt-5.6-sol
