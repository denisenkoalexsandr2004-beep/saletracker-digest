# Runtime public URL used to build personal preview, settings and webhook links.
APP_URL=http://localhost:3000

# Public username without @. Without it the app safely works in demo mode.
TELEGRAM_BOT_USERNAME=

# Server-only Telegram secrets. Never prefix them with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_SECRET=

# Persistent PostgreSQL storage. Without it the app uses the explicit local demo adapter.
DATABASE_URL=
DB_POOL_SIZE=5

# Same-domain admin session. ADMIN_PASSWORD may differ from TELEGRAM_ADMIN_SECRET.
ADMIN_PASSWORD=
SESSION_SECRET=

# Protects scheduled job endpoints called by the production scheduler.
CRON_SECRET=

# AI news research.
OPENAI_API_KEY=
OPENAI_NEWS_MODEL=gpt-5.6-sol
NEWS_INGESTION_MAX_AGE_MINUTES=150
NEWS_APPROVED_SOURCE_MAX_AGE_HOURS=48

# Исходящий прокси. Нужен, когда приложение стоит на российском IP:
# Telegram и OpenAI по таким адресам не отвечают. Запросы уходят наружу
# через зарубежный сервер. Запускать Node с флагом --use-env-proxy.
# База и локальные адреса идут напрямую, минуя прокси.
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=127.0.0.1,localhost,.neon.tech

# Предел времени на один запрос к исследовательскому агенту.
# 55 c — под лимит serverless-функции (60 c). На своём сервере можно 180000.
NEWS_AGENT_TIMEOUT_MS=55000
