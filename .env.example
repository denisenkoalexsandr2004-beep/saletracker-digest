# Runtime public URL used to build personal preview, settings and webhook links.
APP_URL=http://localhost:3000

# Public username without @. Without it the app safely works in demo mode.
TELEGRAM_BOT_USERNAME=

# Server-only Telegram secrets. Never prefix them with NEXT_PUBLIC_.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_SECRET=

# Persistent PostgreSQL storage. Without it the app uses the explicit local demo adapter.
DATABASE_URL=
DB_POOL_SIZE=5

# Same-domain admin session. ADMIN_PASSWORD may differ from TELEGRAM_ADMIN_SECRET.
ADMIN_PASSWORD=
SESSION_SECRET=

# Protects scheduled job endpoints called by the production scheduler.
CRON_SECRET=

# AI provider used to classify and structure articles from the durable queue.
# Values: openai | perplexity. Configure the matching key below.
NEWS_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_NEWS_MODEL=gpt-5.6-luna
PERPLEXITY_API_KEY=
PERPLEXITY_NEWS_MODEL=sonar
NEWS_INGESTION_MAX_AGE_MINUTES=150
NEWS_APPROVED_SOURCE_MAX_AGE_HOURS=48

# Исходящий прокси. Нужен, когда приложение стоит на российском IP:
# Telegram и OpenAI по таким адресам не отвечают. Запросы уходят наружу
# через зарубежный сервер. Запускать Node с флагом --use-env-proxy.
# База и локальные адреса идут напрямую, минуя прокси.
HTTPS_PROXY=
HTTP_PROXY=
NO_PROXY=127.0.0.1,localhost,.neon.tech

# Предел времени на один запрос к исследовательскому агенту.
# 55 c — под лимит serverless-функции (60 c). На своём сервере можно 180000.
NEWS_AGENT_TIMEOUT_MS=55000

# Надёжная очередь разбора. За запуск берётся небольшая пачка, внутри которой
# статьи обрабатываются независимо. Повторные попытки не повторяют уже готовые.
NEWS_PROCESSING_BATCH_SIZE=8
NEWS_PROCESSING_CONCURRENCY=3
NEWS_PROCESSING_MAX_ATTEMPTS=3
NEWS_PROCESSING_RETRY_DELAY_MS=300000
NEWS_PROCESSING_LEASE_MINUTES=15

# Ошибки AI-провайдера автоматически возвращаются из dead-letter после паузы.
# Ошибки качества, дубли и отклонённые статьи не переобрабатываются.
NEWS_DEAD_LETTER_RETRY_HOURS=6
NEWS_DEAD_LETTER_REQUEUE_BATCH_SIZE=24

# Автономная публикация только структурно проверенных карточек из реестра
# источников. Отключите, если нужен обязательный ручной редакционный контроль.
NEWS_AUTO_APPROVE=true
NEWS_AUTO_APPROVE_MIN_CONFIDENCE=0.8

# Короткая пачка укладывается в serverless timeout. Планировщик продолжает её
# каждые пять минут; issueKey защищает Telegram от повторной отправки.
DIGEST_DISPATCH_BATCH_SIZE=6
