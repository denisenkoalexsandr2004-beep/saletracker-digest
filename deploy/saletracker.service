# /etc/systemd/system/saletracker.service
# systemctl daemon-reload && systemctl enable --now saletracker

[Unit]
Description=SaleTracker Digest
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=saletracker
WorkingDirectory=/srv/saletracker
EnvironmentFile=/srv/saletracker/.env.production
ExecStart=/usr/bin/node node_modules/.bin/next start --port 3000
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

# Постоянный процесс переживает отправку многочастного дайджеста целиком,
# поэтому лимиты времени выполнения, обязательные в serverless, здесь не нужны.

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/saletracker/.next

[Install]
WantedBy=multi-user.target
